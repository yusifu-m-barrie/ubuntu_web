NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Enables Google Analytics when set to a G- measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
RESEND_API_KEY=
EMAIL_FROM=Ubuntu Tech Africa <noreply@ubuntuafrika-sl.com>
CONTACT_TO_EMAIL=d.salifu@ubuntuafrika.com
SANITY_REVALIDATE_SECRET=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
# Private Vercel Blob is required on Vercel so application documents are never stored in the database or served publicly.

# Required: at least 32 random characters. Used to sign admin session cookies.
ADMIN_SESSION_SECRET=

# Required on Vercel. Generate with: npx tsx scripts/hash-admin-password.ts "<password>"
ADMIN_PASSWORD_HASH=

# Local development only. Ignored on Vercel; never set this in production.
ADMIN_PASSWORD=

# Staff inbox for new application alerts. Falls back to CONTACT_TO_EMAIL if unset.
APPLICATIONS_NOTIFY_EMAIL=
